# Riskwright environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=riskwright
POSTGRES_USER=riskwright
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Read-only role used by the chatbot's query runner.
# Defence in depth: even if SQL validation is bypassed, this role cannot write.
POSTGRES_RO_USER=riskwright_ro
POSTGRES_RO_PASSWORD=change_me_too

# --- Data -------------------------------------------------------------------
# Host path holding the extracted Home Credit CSVs. Mounted read-only into the
# loader container. Keep this OUTSIDE any cloud-synced folder.
# Windows example: C:/data/home-credit
DATA_DIR=/absolute/path/to/home-credit-csvs

# Set true to re-ingest the CSVs even if the tables already hold rows.
FORCE_RELOAD=false

# --- LLM --------------------------------------------------------------------
# Belongs to the api service only. Never expose it to the UI container.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Services ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Base URL the Streamlit UI uses to reach the API.
API_URL=http://api:8000
LOG_LEVEL=INFO
