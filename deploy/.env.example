# Riskwright deployment environment.
#
# Copy to .env next to docker-compose.deploy.yml on the host and fill in.
# This file is the whole configuration surface: there is no DATA_DIR, because
# the data ships inside the postgres image, and no build arguments, because
# nothing is built on the host.
#
#   cp .env.example .env && nano .env
#
# .env stays on the VM. It is not in the repository and not in any image.

# --- Postgres ---------------------------------------------------------------
# The database itself is not published to the host, so these guard the compose
# network rather than the internet. Use real values anyway.
POSTGRES_DB=riskwright
POSTGRES_USER=riskwright
POSTGRES_PASSWORD=

# The chatbot's SELECT-only role. Read on the postgres container's FIRST boot
# to recreate the role inside the seeded image: pg_dump does not carry roles,
# so this is what keeps the "SELECT on exactly three tables and nothing else"
# property true in the deployment.
#
# Both values must be set. An unset password aborts the container's init
# rather than creating a passwordless role.
#
# Changing this after the first boot has no effect -- the init scripts run once
# against an empty data directory. To rotate it, either ALTER ROLE by hand or
# remove the pgdata volume and let the image re-seed.
POSTGRES_RO_USER=riskwright_ro
POSTGRES_RO_PASSWORD=

# --- LLM --------------------------------------------------------------------
# Required for the chatbot only. Every other module works without it, and the
# UI reports the assistant as unconfigured rather than failing.
#
# Supplied here at run time and nowhere else. It is not baked into any image
# and must never be committed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
